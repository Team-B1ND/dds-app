{
  "name": "dds-app",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react-dom"]
    },
    "packageExtensions": {
      "styled-components": {
        "peerDependencies": {
          "react-native": "*"
        },
        "peerDependenciesMeta": {
          "react-dom": {
            "optional": true
          }
        }
      }
    }
  },
  "description": "b1nd dodamdodam react native design system monorepo",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-B1ND/dds-app.git"
  },
  "author": "b1nd <mdev_team@dgsw.hs.kr> (https://github.com/Team-B1ND)",
  "license": "MIT",
  "devDependencies": {
    "@babel/runtime": "^7.26.0",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/eslint-config": "0.83.0",
    "@types/react": "^19.1.12",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^2.8.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-monorepo-config": "^0.3.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.15.3",
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
